{
  "name": "tw-smart-apps",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*/backend",
    "apps/*/frontend"
  ],
  "scripts": {
    "build-nhi-index": "node packages/nhi-data/src/build-index.mjs",
    "seed": "node packages/smart-client/src/seed-conditions.mjs",
    "dev:lipid": "npm --workspace @tw-app/lipid-cds-backend run dev",
    "dev:claim": "npm --workspace @tw-app/nhi-claim-backend run dev"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
